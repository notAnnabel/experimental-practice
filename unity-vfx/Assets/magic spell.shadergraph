{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "9b49eb8d74484d608ec00dc6b3012353",
    "m_Title": "",
    "m_Content": "The one minus node subtracts the inputs by one, so it acts like a colour swapper here. \n\nThe noise speed +time are multiplied to create a change in the fraction. This fraction is added to the one minus value and as the fraction value changes the add result also changes with time.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 2363.0,
