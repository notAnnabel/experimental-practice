{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "3c7d5483d41c4dc2ba03edd4441b6aec",
    "m_Title": "",
    "m_Content": "creates a noise speed property that is multiplied over time. A twirl strength property is also created. Together these nodes changes the twirl speed. I added in a noise 2D texture, this texture is swirled. ",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 215.0,
        "y": 1035.0,
        "width": 200.0,
